// used this for the reset all times in Q1 for Q2 and the Q2 for Q3
void reset_time_qualyfing(struct piloto *p1[], int tamanho, int isq1q2q3){
    int i;
    if(isq1q2q3 == 1){
        for(i = 0; i < VETOR_TAMANHO; i++){
            p1[i] -> fatest_time = BASE_TIME;
        }
    }else if(isq1q2q3 == 2){
        for(i = 0; i < VETOR_TAMANHO - 5; i++){
            p1[i] -> fatest_time = BASE_TIME;
        }
    }else if(isq1q2q3 == 3){
        for(i = 0; i < VETOR_TAMANHO - 10; i++){
            p1[i] -> fatest_time = BASE_TIME;
        }
    }

}
void qualyfing_organization(struct piloto *p1[], int tamanho, int q1q2q3){
    struct piloto *temp;
    int i;
    int passada;
    if(q1q2q3 == 1){
        for(passada = 0; passada < tamanho - 1; passada++){
            for(i = 0; i < tamanho - passada - 1; i++){
                if(p1[i] -> fatest_time > p1[i + 1] -> fatest_time){
                    temp = p1[i];
                    p1[i] = p1[i + 1];
                    p1[i + 1] = temp;
                }
            }
        }
    }else if(q1q2q3 == 2){
        for(passada = 0; passada < tamanho - 6; passada++){
            for(i = 0; i < tamanho - passada - 6; i++){
                if(p1[i] -> fatest_time > p1[i + 1] -> fatest_time){
                    temp = p1[i];
                    p1[i] = p1[i + 1];
                    p1[i + 1] = temp;
                }
            }
        }
    }else if(q1q2q3 == 3){
        for(passada = 0; passada < tamanho - 11; passada++){
            for(i = 0; i < tamanho - passada - 11; i++){
                if(p1[i] -> fatest_time > p1[i + 1] -> fatest_time){
                    temp = p1[i];
                    p1[i] = p1[i + 1];
                    p1[i + 1] = temp;
                }
            }
        }
    }
    
    for(i = 0; i < tamanho; i++){
        p1[i] -> position = i + 1;
    }
    
}
